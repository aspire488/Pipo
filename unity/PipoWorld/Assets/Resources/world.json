    "npcs": [
        {
            "id": "grumble",
            "name": "Grumble",
            "placeId": "hardware",
            "hello": "Grumble looked at him for a long time. Then said: \"Screws are aisle two.\""
        },
        {
            "id": "juniper",
            "name": "Juniper",
            "placeId": "electronics",
            "hello": "Juniper blinked all her lights at him. That's hello, apparently."
        },
        {
            "id": "pim",
            "name": "Mrs. Pim",
            "placeId": "market",
            "hello": "Mrs. Pim said he was too small to carry a basket. He carried it anyway."
        },
        {
            "id": "mo",
            "name": "Mo",
            "placeId": "bakery",
            "hello": "Mo was covered in flour. So is Pipo now."
        },
        {
            "id": "ada",
            "name": "Ada",
            "placeId": "cafe",
            "hello": "Ada gave him a mug bigger than his head. He loved it."
        },
        {
            "id": "rook",
            "name": "Old Rook",
            "placeId": "secondhand",
            "hello": "Old Rook said everything here used to be something else. Including Rook."
        },
        {
            "id": "fennel",
            "name": "Fennel",
            "placeId": "repair",
            "hello": "Fennel handed him a screwdriver before saying hi."
        },
        {
            "id": "tess",
            "name": "Tess",
            "placeId": "library",
            "hello": "Tess whispered hello. He whispered it back. Too loud."
        },
        {
            "id": "raj",
            "name": "Coach Raj",
            "placeId": "cricket",
            "hello": "Coach Raj fixed his grip on the bat. Then said 'well left' when he missed."
        },
        {
            "id": "lin",
            "name": "Lin",
            "placeId": "sports_hall",
            "hello": "Lin returned every single ball. Every one. With a smile."
        },
        {
            "id": "bea",
            "name": "Bea",
            "placeId": "court",
            "hello": "Bea kept score on a little chalkboard. She draws a smiley for every point."
        },
        {
            "id": "kip",
            "name": "Kip",
            "placeId": "field",
            "hello": "Kip kicked the ball to him. He missed it. Kip was nice about it."
        }
