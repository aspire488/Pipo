<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: lets device test scripts run Pipo's hourly worker on demand.
             Exported (the shell has to reach it) but guarded by android.permission.DUMP —
             held by adb's shell uid and by this app, never by ordinary third-party apps. -->
        <receiver
            android:name=".DebugWorkerReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />
        <!-- Debug builds only: speaks a test phrase from the phone's speaker for the mic test. Same DUMP guard. -->
        <receiver
            android:name=".DebugSayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />
        <!-- Debug builds only: one recogniser session with a chosen service, for the mic test. Same DUMP guard. -->
        <receiver
            android:name=".DebugEarsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
