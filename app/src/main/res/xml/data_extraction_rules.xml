<?xml version="1.0" encoding="utf-8"?>
<!--
    Pipo's world never leaves the phone (see docs/PRIVACY_POLICY.md): no cloud backup and no
    device-to-device transfer of any app data. On Android 11 and lower the matching switch is
    android:allowBackup="false" in the manifest; on Android 12+ these rules govern it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
