<?xml version="1.0" encoding="utf-8"?>
<!-- The one thing Pipo asks Android for: lock the screen, exactly like the power button.
     No wipe, no password rules, no app control — just force-lock. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
