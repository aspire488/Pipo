<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only when you ask: talking to Pipo with your voice. Requested on first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Rare messages from Pipo (Android 13+ asks once, after you've spent some time together). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Pipo Voice" (opt-in, off until you switch it on in Settings): listens for "Pipo, ..."
         while your screen is on, with a persistent notification you can turn it off from. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Pop up when called" (opt-in, Android's own switch): lets Pipo come on screen when you say
         "Pipo, ..." from another app. Used only for that brief face bubble + opening himself. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional AI conversation only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Is the internet there?" Normal permission, auto-granted, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Timers/alarms you explicitly ask for. Normal permission, no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Brightness and auto-rotate when you ask. A special access: nothing happens until YOU allow
         "Modify system settings" for Pipo in Android settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Do Not Disturb / silent mode when you ask. Also only works after YOU allow "Do Not Disturb access". -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The torch is controlled through CameraManager.setTorchMode, which needs no CAMERA permission.
         Pipo never opens the camera himself; he launches your camera app. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Package visibility (Android 11+) for the few apps Pipo can open by name. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="android.intent.action.WEB_SEARCH" /></intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.google.android.deskclock" />
        <!-- "open <any app>" and "what music apps do I have": apps in your launcher, only when you ask -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="spotify" /></intent>
    </queries>

    <application
        android:name=".PipoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pipo">
        <!-- "Pipo, look!": your camera app saves the one snapshot here for him; it's deleted after he looks -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.look"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/pipo_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pipo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".notify.NotificationActionReceiver" android:exported="false" />

        <!-- Optional: Pipo notices chat/social notifications ("ooh, someone sent you a reel!").
             Does nothing unless you switch on Notification access for Pipo in Android settings.
             Only the app and a coarse kind are used; content and senders are never kept. -->
        <service
            android:name=".notify.PipoNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Pipo Voice": the opt-in listener for "Pipo, ...". Microphone foreground service,
             notification always visible, off by default. -->
        <service
            android:name=".voice.PipoVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- "Pipo lock": Android's device admin, requesting only the force-lock policy so
             DevicePolicyManager.lockNow() is allowed. Shown in Android's own activation screen
             before it can do anything. -->
        <receiver
            android:name=".lock.PipoDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/pipo_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
